# Mastra service configuration — copy to skills/story-maker-v5-mastra/.env
# (media credentials still live in the repo-root .env: FAL_KEY,
#  REPLICATE_API_TOKEN, COMFYUI_URL, COMFYUI_AUTH)

# ── LLM provider ──────────────────────────────────────────────────────────
# Provider for all agents (anything Mastra's model router understands).
LLM_PROVIDER=anthropic

# Default model for authoring agents. Bare ids get LLM_PROVIDER prepended;
# "provider/model" values are used verbatim. For OpenRouter use the full
# "openrouter/<vendor>/<model>" form — a bare "deepseek/..." id resolves to
# the DeepSeek API provider, not OpenRouter.
LLM_MODEL=claude-sonnet-4-5
# LLM_MODEL=openrouter/deepseek/deepseek-v4.1-flash

# Vision agents (video-prompter, spatial-qa) — pick a strong vision model;
# they receive the real storyboard sheet image bytes.
# VISION_MODEL=anthropic/claude-sonnet-4-5

# Critique + plan-fixer agents (falls back to LLM_MODEL).
# CRITIQUE_MODEL=anthropic/claude-sonnet-4-5

# Per-agent override, e.g. MODEL_VIDEO_PROMPTER=openai/gpt-5
# MODEL_<AGENT_ID_IN_UPPER_SNAKE>=provider/model

# ── Pipeline tuning ───────────────────────────────────────────────────────
# STORIES_ROOT=stories                    # default: <skill>/stories
# OUTPUTS_ROOT=outputs/story-maker-v5-mastra
# PYTHON_BIN=python3
# Point this at the conda env that has requirements.txt installed — the
# prompt/image validators import httpx, fal_client, etc. which a bare
# system python3 lacks. E.g. PYTHON_BIN=/path/to/.conda-envs/story-v5/bin/python
# MAX_AUTHORING_ATTEMPTS=4                # write→validate→fix retries per artifact
# MAX_CRITIQUE_ROUNDS=3                   # critique→fix rounds before GATE 0 suspends
